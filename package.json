{
  "name": "teampulse-tracker",
  "version": "1.0.0",
  "description": "TeamPulse Time Tracking Agent",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg",
    "dist:mac:signed": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis"
  },
  "author": "Your Name",
  "license": "ISC",
  "dependencies": {
    "firebase": "^10.7.1"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.teampulse.tracker",
    "productName": "TeamPulse Agent",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "compression": "maximum",
    "files": [
      "main.js",
      "index.html",
      "icon.png",
      "icon-mac.png",
      "icon-mac.icns",
      "icon.ico",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": {
        "teamId": "C94PA5YM57"
      },
      "icon": "icon-mac.icns"
    },
    "dmg": {
      "title": "TeamPulse Agent",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TeamPulse Agent"
    }
  }
}
